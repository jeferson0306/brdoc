                    "type": "boolean"
                },
                "key": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                },
                "raw_value": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            }
        },
        "models.BatchSummary": {
            "type": "object",
            "properties": {
                "invalid": {
